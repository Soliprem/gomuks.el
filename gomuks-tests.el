(ert-deftest gomuks-mute-follows-push-rules-and-toggles-backend ()
  (let ((gomuks--muted-rooms (make-hash-table :test 'equal))
        (gomuks--rooms (make-hash-table :test 'equal))
        sent notices)
    (puthash "!room:test" '((name . "Test")) gomuks--rooms)
    (gomuks--apply-sync
     '((account_data . ((m.push_rules .
                        ((content . ((global . ((room .
                                                (((rule_id . "!room:test")
                                                  (enabled . t)
                                                  (actions . nil))))))))))))))
    (should (gethash "!room:test" gomuks--muted-rooms))
    (cl-letf (((symbol-function 'gomuks--post)
               (lambda (command data callback)
                 (setq sent (list command data))
                 (funcall callback nil nil)))
              ((symbol-function 'gomuks--render-rooms) #'ignore)
              ((symbol-function 'gomuks--render-room) #'ignore))
      (with-temp-buffer
        (gomuks-room-mode)
        (setq gomuks--room-id "!room:test")
        (gomuks-toggle-mute)
        (should (equal (car sent) "mute_room"))
        (should (string-match-p "\"muted\":false" (json-serialize (cadr sent))))
        (should-not (gethash gomuks--room-id gomuks--muted-rooms))
        (gomuks-toggle-mute)
        (should (string-match-p "\"muted\":true" (json-serialize (cadr sent))))
        (should (gethash gomuks--room-id gomuks--muted-rooms))))
    (let ((gomuks-echo-area-notifications t)
          (gomuks-desktop-notifications nil))
      (cl-letf (((symbol-function 'message)
                 (lambda (&rest args) (push args notices))))
        (gomuks--notify "!room:test"
                        '((sender . "@alice:test")
                          (content . ((body . "hello")))))
        (should-not notices)))))

(ert-deftest gomuks-sticker-displays-as-sticker ()
  (with-temp-buffer
    (gomuks-room-mode)
    (setq gomuks--room-id "!room:test")
    (let ((event '((type . "m.sticker") (sender . "@alice:test")
                   (content . ((body . "smile")
                               (url . "mxc://test/sticker"))))))
      (cl-letf (((symbol-function 'gomuks--cached-media)
                 (lambda (_attachment) "/tmp/sticker.png"))
                ((symbol-function 'gomuks--maybe-preview-image) #'ignore)
                ((symbol-function 'display-images-p) (lambda (&rest _) t))
                ((symbol-function 'create-image)
                 (lambda (_file _type _data &rest _) '(image :type png))))
        (let ((inhibit-read-only t))
          (gomuks--insert-event event))
        (should (string-match-p "Sticker: smile" (buffer-string)))
        (should-not (string-match-p "\\[IMAGE\\]\\|Open  Save" (buffer-string)))
        (goto-char (point-min))
        (search-forward "Sticker: smile")
        (should (button-at (1- (point))))
        (should (equal (get-text-property (1- (point)) 'display)
                       '(image :type png)))))))

(ert-deftest gomuks-sync-renders-room-and-messages ()
  (let ((gomuks--rooms (make-hash-table :test 'equal))
        (gomuks--events (make-hash-table :test 'equal))
        (gomuks--member-state (make-hash-table :test 'equal))
        (gomuks--requested-members (make-hash-table :test 'equal))
        (gomuks--timelines (make-hash-table :test 'equal))
        (gomuks--timeline-ids (make-hash-table :test 'equal)))
    (unwind-protect
        (save-window-excursion
          (with-current-buffer (get-buffer-create "*Gomuks*")
            (gomuks-rooms-mode))
          (gomuks--apply-sync
           '((rooms . (("!room:test" .
                       ((meta . ((name . "Test room")
                                 (sorting_timestamp . 123)))
                        (state . ((m.room.member . (("@a:test" . 12)))))
                        (events . (((rowid . 12) (type . "m.room.member")
                                    (state_key . "@a:test")
                                    (content . ((membership . "join")
                                                (displayname . "Alice Example"))))
                                   ((rowid . 10) (event_id . "$one")
                                    (sender . "@a:test")
                                    (type . "m.room.message")
                                    (timestamp . 100000)
                                    (content . ((body . "Hello"))))
                                   ((rowid . 11) (event_id . "$two")
                                    (sender . "@a:test")
                                    (type . "m.room.message")
                                    (timestamp . 101000)
                                    (content . ((body . "Second"))))))
                        (timeline . (((timeline_rowid . 1)
                                      (event_rowid . 10))
                                     ((timeline_rowid . 2)
                                      (event_rowid . 11))))))))))
          (with-current-buffer "*Gomuks*"
            (should (string-match-p "Test room" (buffer-string)))
            (goto-char (point-min))
            (search-forward "Test room")
            (gomuks-open-room))
          (with-current-buffer "*Gomuks: !room:test*"
            (should (string-match-p "Alice Example" (buffer-string)))
            (should-not (string-match-p "@a:test" (buffer-string)))
            (should (string-match-p "Hello" (buffer-string)))
            (should (string-match-p "Hello\n[0-9: ]+│  Second" (buffer-string)))
            (goto-char (point-min))
            (search-forward "Alice Example")
            (should (equal (get-text-property (1- (point)) 'help-echo) "@a:test"))
            (goto-char (point-min))
            (search-forward "Hello")
            (should (equal "$one"
                           (gomuks--alist 'event_id (gomuks--event-at-point))))
            (gomuks-copy-sender-id)
            (should (equal (current-kill 0) "@a:test")))
          (should (get-buffer "*Gomuks compose: !room:test*"))
          (should (get-buffer-window "*Gomuks compose: !room:test*")))
      (dolist (name '("*Gomuks*" "*Gomuks: !room:test*"
                      "*Gomuks compose: !room:test*"))
        (when-let* ((buffer (get-buffer name))) (kill-buffer buffer))))))

(ert-deftest gomuks-open-room-loads-first-history-page-once ()
  (let ((gomuks--rooms (make-hash-table :test 'equal))
        (gomuks--events (make-hash-table :test 'equal))
        (gomuks--member-state (make-hash-table :test 'equal))
        (gomuks--requested-members (make-hash-table :test 'equal))
        (gomuks--timelines (make-hash-table :test 'equal))
        (gomuks--timeline-ids (make-hash-table :test 'equal))
        (gomuks--stream nil)
        (requests 0)
        (id "!initial:test"))
    (unwind-protect
        (save-window-excursion
          (puthash id '((name . "Initial room")) gomuks--rooms)
          (with-current-buffer (get-buffer-create "*Gomuks test home*")
            (gomuks-rooms-mode)
            (let ((inhibit-read-only t))
              (insert "Initial room\n")
              (put-text-property (point-min) (point-max) 'gomuks-room-id id))
            (goto-char (point-min)))
          (cl-letf (((symbol-function 'gomuks--post)
                     (lambda (command data callback)
                       (should (equal command "paginate"))
                       (should (= (gomuks--alist 'limit data) 50))
                       (setq requests (1+ requests))
                       (funcall callback nil
                                '((events . (((rowid . 1)
                                              (timeline_rowid . 1)
                                              (room_id . "!initial:test")
                                              (event_id . "$initial")
                                              (type . "m.room.message")
                                              (sender . "@a:test")
                                              (content . ((body . "First page")))))))))))
            (with-current-buffer "*Gomuks test home*"
              (goto-char (point-min))
              (gomuks-open-room))
            (should (= requests 1))
            (with-current-buffer (format "*Gomuks: %s*" id)
              (should (string-match-p "First page" (buffer-string))))
            (with-current-buffer "*Gomuks test home*" (gomuks-open-room))
            (should (= requests 1))))
      (dolist (name (list "*Gomuks test home*" (format "*Gomuks: %s*" id)
                          (format "*Gomuks compose: %s*" id)))
        (when-let* ((buffer (get-buffer name))) (kill-buffer buffer))))))

(ert-deftest gomuks-room-render-keeps-scroll-position-and-bottom ()
  (let ((gomuks--rooms (make-hash-table :test 'equal))
        (gomuks--events (make-hash-table :test 'equal))
        (gomuks--timelines (make-hash-table :test 'equal))
        (gomuks--member-state (make-hash-table :test 'equal))
        (gomuks--requested-members (make-hash-table :test 'equal))
        (gomuks--stream nil)
        (id "!scroll:test")
        (room (generate-new-buffer "*gomuks-scroll-test*")))
    (unwind-protect
        (save-window-excursion
          (dotimes (index 80)
            (let ((rowid (1+ index)))
              (puthash rowid
                       `((rowid . ,rowid) (room_id . ,id)
                         (event_id . ,(format "$%s" rowid))
                         (sender . "@a:test") (type . "m.room.message")
                         (timestamp . ,(* rowid 60000))
                         (content . ((body . ,(format "Message %s" rowid)))))
                       gomuks--events)))
          (puthash id (number-sequence 1 80) gomuks--timelines)
          (with-current-buffer room
            (gomuks-room-mode)
            (setq gomuks--room-id id))
          (switch-to-buffer room)
          (gomuks--render-buffer room id)
          (let ((window (selected-window)))
            (with-current-buffer room
              (let ((position (text-property-any (point-min) (point-max)
                                                 'gomuks-event-rowid 10)))
                (set-window-point window position)
                (set-window-start window position t)
                (redisplay t))
              (let ((before (get-text-property (window-start window)
                                               'gomuks-event-rowid)))
                (should (and before (< before 80)))
              (puthash 81
                       `((rowid . 81) (room_id . ,id) (event_id . "$81")
                         (sender . "@a:test") (type . "m.room.message")
                         (timestamp . 4860000)
                         (content . ((body . "Message 81"))))
                       gomuks--events)
              (puthash id (number-sequence 1 81) gomuks--timelines)
              (gomuks--render-buffer room id)
              (should (equal (get-text-property (window-start window)
                                                'gomuks-event-rowid) before)))
              (goto-char (point-max))
              (recenter -1)
              (let* ((composer (generate-new-buffer "*gomuks-scroll-composer-test*"))
                     (composer-window (split-window window -6 'below)))
                (unwind-protect
                    (progn
                      (set-window-buffer composer-window composer)
                      (with-selected-window window
                        (goto-char (point-max))
                        (recenter -1))
                      (select-window composer-window)
                      (puthash 82
                               `((rowid . 82) (room_id . ,id) (event_id . "$82")
                                 (sender . "@a:test") (type . "m.room.message")
                                 (timestamp . 4920000)
                                 (content . ((body . "Message 82"))))
                               gomuks--events)
                      (puthash id (number-sequence 1 82) gomuks--timelines)
                      (gomuks--render-buffer room id)
                      (should (= (window-point window)
                                 (with-current-buffer room (point-max)))))
                  (kill-buffer composer))))))
      (kill-buffer room))))

(ert-deftest gomuks-reply-uses-matrix-relation ()
  (let ((sent nil))
    (cl-letf (((symbol-function 'gomuks--post)
               (lambda (command data _callback)
                 (setq sent (cons command data)))))
      (with-temp-buffer
        (gomuks-room-mode)
        (setq gomuks--room-id "!room:test")
        (let ((inhibit-read-only t))
          (insert "message\n")
          (put-text-property (point-min) (point-max) 'gomuks-event
                             '((event_id . "$event"))))
        (goto-char (point-min))
        (gomuks-reply "reply")))
    (should (equal (car sent) "send_message"))
    (should (equal (gomuks--alist 'event_id
                                  (gomuks--alist 'm.in_reply_to
                                                 (gomuks--alist 'relates_to (cdr sent))))
                   "$event"))
    (should (string-match-p "m.in_reply_to"
                            (json-serialize (cdr sent))))))

(ert-deftest gomuks-active-room-marks-newest-visible-message-read ()
  (let ((gomuks--rooms (make-hash-table :test 'equal))
        (gomuks--events (make-hash-table :test 'equal))
        (gomuks--timelines (make-hash-table :test 'equal))
        (gomuks--last-read (make-hash-table :test 'equal))
        (room (generate-new-buffer "*gomuks-read-test*"))
        (other (generate-new-buffer "*gomuks-other-test*"))
        (sent nil))
    (unwind-protect
        (save-window-excursion
          (puthash "!room:test" '((unread_messages . 2)) gomuks--rooms)
          (puthash 1 '((rowid . 1) (event_id . "$latest")) gomuks--events)
          (puthash "!room:test" '(1) gomuks--timelines)
          (with-current-buffer room
            (gomuks-room-mode)
            (setq gomuks--room-id "!room:test")
            (let ((inhibit-read-only t)) (insert "latest\n")))
          (switch-to-buffer room)
          (cl-letf (((symbol-function 'gomuks--post)
                     (lambda (command data callback)
                       (push (cons command data) sent)
                       (funcall callback nil nil))))
            (gomuks--maybe-mark-read)
            (gomuks--maybe-mark-read)
            (should (= (length sent) 1))
            (should (equal (gomuks--alist 'event_id (cdar sent)) "$latest"))
            (switch-to-buffer other)
            (clrhash gomuks--last-read)
            (gomuks--maybe-mark-read)
            (should (= (length sent) 1))))
      (kill-buffer room)
      (kill-buffer other))))

(ert-deftest gomuks-reply-preview-follows-parent ()
  (let* ((gomuks--events (make-hash-table :test 'equal))
         (parent '((rowid . 1) (room_id . "!room:test")
                   (event_id . "$parent") (sender . "@a:test")
                   (type . "m.room.message")
                   (content . ((body . "Original")))))
         (reply '((rowid . 2) (room_id . "!room:test")
                  (event_id . "$reply") (sender . "@b:test")
                  (type . "m.room.message")
                  (content . ((body . "> <@a:test> Original\n\nAnswer")
                              (m.relates_to . ((m.in_reply_to .
                                                ((event_id . "$parent")))))))))
         (room (generate-new-buffer "*gomuks-reply-test*")))
    (unwind-protect
        (save-window-excursion
          (puthash 1 parent gomuks--events)
          (with-current-buffer room
            (gomuks-room-mode)
            (setq gomuks--room-id "!room:test")
            (let ((inhibit-read-only t))
              (gomuks--insert-event parent)
              (gomuks--insert-event reply))
            (should (string-match-p "↪ a: Original" (buffer-string)))
            (should-not (string-match-p "> <@a:test>" (buffer-string))))
          (switch-to-buffer room)
          (goto-char (point-min))
          (search-forward "Answer")
          (gomuks-follow-reply)
          (should (equal (gomuks--alist 'event_id (gomuks--event-at-point))
                         "$parent")))
      (kill-buffer room))))

(ert-deftest gomuks-search-pages-and-returns-from-result-context ()
  (let* ((gomuks--rooms (make-hash-table :test 'equal))
         (gomuks--events (make-hash-table :test 'equal))
         (gomuks--member-state (make-hash-table :test 'equal))
         (gomuks--requested-members (make-hash-table :test 'equal))
         (gomuks--stream nil)
         (id "!search:test")
         (first '((rowid . 1) (room_id . "!search:test")
                  (event_id . "$first") (sender . "@a:test")
                  (type . "m.room.message")
                  (content . ((body . "first match")))))
         (second '((rowid . 2) (room_id . "!search:test")
                   (event_id . "$second") (sender . "@a:test")
                   (type . "m.room.message")
                   (content . ((body . "second match")))))
         (room (generate-new-buffer "*gomuks-search-source-test*"))
         (search-name (format "*Gomuks search: %s*" id))
         (context-name "*Gomuks context: $first*")
         (requests nil))
    (unwind-protect
        (save-window-excursion
          (puthash id '((name . "Search room")) gomuks--rooms)
          (with-current-buffer room
            (gomuks-room-mode)
            (setq gomuks--room-id id))
          (switch-to-buffer room)
          (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "match"))
                    ((symbol-function 'gomuks--post)
                     (lambda (command data callback)
                       (push (cons command data) requests)
                       (pcase command
                         ("search_local"
                          (funcall callback nil
                                   (if (gomuks--alist 'next_batch data)
                                       `((events . (,second)))
