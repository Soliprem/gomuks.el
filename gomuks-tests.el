(ert-deftest gomuks-recovery-keeps-file-ownership-with-the-selected-draft ()
  (dolist (closed '(nil t))
    (gomuks-test-with-state
     (let* ((file (make-temp-file "gomuks-recovery-"))
            (attachment (list file t "Owned file"))
            (send (gomuks--make-send :id 1 :phase 'uncertain :room "!recover"
                                     :text "retained text" :remaining (list attachment)))
            (pending (gomuks--make-send :id 2 :phase 'queued :room "!recover"))
            (recovered (generate-new-buffer " *gomuks-recovered-test*"))
            confirm)
       (unwind-protect
           (with-temp-buffer
             (gomuks-compose-mode) (setq gomuks--compose-job pending)
             (puthash 1 send gomuks--sends) (puthash 2 pending gomuks--sends)
             (cl-letf (((symbol-function 'completing-read)
                        (lambda (_prompt choices &rest _)
                          (should (equal (mapcar #'cdr choices) (list send))) (caar choices)))
                       ((symbol-function 'get-buffer-create) (lambda (_name) recovered))
                       ((symbol-function 'pop-to-buffer) #'ignore)
                       ((symbol-function 'yes-or-no-p) (lambda (&rest _) confirm)))
               (gomuks-restore-send)
               (with-current-buffer recovered
                 (should (equal (buffer-string) "retained text"))
                 (should (equal gomuks--compose-attachment (list attachment)))
                 (should (eq gomuks--compose-job send)))
               (should (eq (gomuks--send-buffer send) recovered))
               (when closed (kill-buffer recovered))
               (should (file-exists-p file))
               (with-current-buffer (if closed (current-buffer) recovered)
                 (gomuks-discard-send)
                 (should (eq (gethash 1 gomuks--sends) send))
                 (setq confirm t)
                 (gomuks-discard-send)
                 (should-not (gethash 1 gomuks--sends)))
               (should (eq (not (null (file-exists-p file))) (not closed)))
               (should (eq (gethash 2 gomuks--sends) pending)))
             (when (buffer-live-p recovered) (kill-buffer recovered))
             (when (file-exists-p file) (delete-file file))))))))

(ert-deftest gomuks-date-separators-use-local-days-and-break-sender-groups ()
  (gomuks-test-with-state
    (let* ((times (list (encode-time 0 58 23 3 10 2026)
                        (encode-time 0 59 23 3 10 2026)
                        (encode-time 0 1 0 4 10 2026)))
           (events (cl-loop for time in times for row from 1
                            collect `((rowid . ,row) (room_id . "!test")
                                      (event_id . ,(format "$%d" row))
                                      (sender . "@alice:test") (type . "m.room.message")
                                      (timestamp . ,(* 1000 (float-time time)))
                                      (content . ((body . ,(format "Message %d" row))))))))
      (gomuks--store-events events)
      (puthash "!test" '(1 2 3) gomuks--timelines)
      (dolist (kind '(room thread context))
        (with-temp-buffer
          (gomuks-room-mode)
          (setq gomuks--room-id "!test"
                gomuks--thread-root (when (eq kind 'thread) "$root")
                gomuks--thread-events '(1 2 3)
                gomuks--context-target (when (eq kind 'context) "$target")
                gomuks--context-events '(1 2 3))
          (gomuks--render-buffer (current-buffer) "!test")
          (should (string-match-p "23:59  │  Message 2" (buffer-string)))
          (should (string-match-p "00:01  alice  Message 3" (buffer-string)))
          (goto-char (point-min))
          (let ((separators 0))
            (while (re-search-forward "── .*2026-10-0[34] ──" nil t)
              (cl-incf separators)
              (should-not (get-text-property (match-beginning 0) 'gomuks-event-rowid))
              (should-error (gomuks--event-at-point) :type 'user-error))
            (should (= separators 2)))
          ;; Prepending history must recompute the first day's separator.
          (setq gomuks--thread-events '(2 3) gomuks--context-events '(2 3))
          (puthash "!test" '(2 3) gomuks--timelines)
          (gomuks--render-buffer (current-buffer) "!test")
          (should (string-match-p "2026-10-03" (buffer-string)))
          (puthash "!test" '(1 2 3) gomuks--timelines))))))

