                       (content . ((body . "Image") (msgtype . "m.image")
                                   (url . "mxc://example/image")))))
              (resolve (symbol-function 'gomuks--events-for-rows))
              (resolutions 0) dependencies previews)
         (gomuks--store-events (list first image))
         (puthash "!snapshot" '(0 99 1) gomuks--timelines)
         (with-temp-buffer
           (if (eq kind 'search) (gomuks-search-mode) (gomuks-room-mode))
           (setq gomuks--room-id "!snapshot" gomuks--view-dirty t
                 gomuks--thread-root (and (eq kind 'thread) "$first")
                 gomuks--context-target (and (eq kind 'context) "$first")
                 gomuks--thread-events '(0 99 1) gomuks--context-events '(0 99 1)
                 gomuks--search-results '(0 99 1))
           (cl-letf (((symbol-function 'gomuks--events-for-rows)
                      (lambda (rows) (cl-incf resolutions) (funcall resolve rows)))
                     ((symbol-function 'gomuks--request-missing-members)
