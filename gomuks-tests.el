        (fail-second t))
    (unwind-protect
        (with-temp-buffer
          (gomuks-compose-mode)
          (setq gomuks--room-id "!room:test")
          (insert "caption")
          (gomuks-send-file first)
          (gomuks-send-file second)
          (cl-letf (((symbol-function 'gomuks--upload-file)
                     (lambda (file _id callback)
                       (let ((content (make-hash-table :test 'equal)))
                         (puthash "body" (file-name-nondirectory file) content)
                         (funcall callback nil content))))
                    ((symbol-function 'gomuks--post)
                     (lambda (_command data callback)
                       (push (cons (gethash "body" (gomuks--alist 'base_content data))
                                   (gomuks--alist 'text data)) attempts)
                       (if (and fail-second
                                (equal (gethash "body" (gomuks--alist 'base_content data))
                                       (file-name-nondirectory second)))
                           (progn (setq fail-second nil)
                                  (funcall callback "HTTP 500: send failed" nil))
                         (gomuks-test-confirm-delivery callback)))))
            (gomuks-compose-send)
            (should (equal (reverse attempts)
                           (list (cons (file-name-nondirectory first) "")
                                 (cons (file-name-nondirectory second) "caption"))))
            (should (= (length gomuks--compose-attachment) 1))
            (should (equal (caar gomuks--compose-attachment) second))
            (should (equal (buffer-string) "caption"))
            (should-not gomuks--compose-sending)
            (gomuks-compose-send)
            (should (= (length attempts) 3))
            (should-not gomuks--compose-attachment)
            (should (equal (buffer-string) ""))))
      (delete-file first)
      (delete-file second))))

