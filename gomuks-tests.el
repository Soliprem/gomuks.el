(ert-deftest gomuks-sync-renders-room-and-messages ()
  (let ((gomuks--rooms (make-hash-table :test 'equal))
        (gomuks--events (make-hash-table :test 'equal))
        (gomuks--member-state (make-hash-table :test 'equal))
        (gomuks--requested-members (make-hash-table :test 'equal))
        (gomuks--timelines (make-hash-table :test 'equal))
        (gomuks--timeline-ids (make-hash-table :test 'equal)))
    (unwind-protect
        (save-window-excursion
          (with-current-buffer (get-buffer-create "*Gomuks*")
            (gomuks-rooms-mode))
          (gomuks--apply-sync
           '((rooms . (("!room:test" .
                       ((meta . ((name . "Test room")
                                 (sorting_timestamp . 123)))
                        (state . ((m.room.member . (("@a:test" . 12)))))
                        (events . (((rowid . 12) (type . "m.room.member")
                                    (state_key . "@a:test")
                                    (content . ((membership . "join")
                                                (displayname . "Alice Example"))))
                                   ((rowid . 10) (event_id . "$one")
                                    (sender . "@a:test")
                                    (type . "m.room.message")
                                    (timestamp . 100000)
                                    (content . ((body . "Hello"))))
                                   ((rowid . 11) (event_id . "$two")
                                    (sender . "@a:test")
                                    (type . "m.room.message")
                                    (timestamp . 101000)
                                    (content . ((body . "Second"))))))
                        (timeline . (((timeline_rowid . 1)
                                      (event_rowid . 10))
                                     ((timeline_rowid . 2)
                                      (event_rowid . 11))))))))))
          (with-current-buffer "*Gomuks*"
            (should (string-match-p "Test room" (buffer-string)))
            (goto-char (point-min))
            (search-forward "Test room")
            (gomuks-open-room))
          (with-current-buffer "*Gomuks: !room:test*"
            (should (string-match-p "Alice Example" (buffer-string)))
            (should-not (string-match-p "@a:test" (buffer-string)))
            (should (string-match-p "Hello" (buffer-string)))
            (should (string-match-p "Hello\n[0-9: ]+│  Second" (buffer-string)))
            (goto-char (point-min))
            (search-forward "Alice Example")
            (should (equal (get-text-property (1- (point)) 'help-echo) "@a:test"))
            (goto-char (point-min))
            (search-forward "Hello")
            (should (equal "$one"
                           (gomuks--alist 'event_id (gomuks--event-at-point))))
            (gomuks-copy-sender-id)
            (should (equal (current-kill 0) "@a:test")))
          (should (get-buffer "*Gomuks compose: !room:test*"))
          (should (get-buffer-window "*Gomuks compose: !room:test*")))
      (dolist (name '("*Gomuks*" "*Gomuks: !room:test*"
                      "*Gomuks compose: !room:test*"))
        (when-let* ((buffer (get-buffer name))) (kill-buffer buffer))))))

(ert-deftest gomuks-open-room-loads-first-history-page-once ()
  (let ((gomuks--rooms (make-hash-table :test 'equal))
        (gomuks--events (make-hash-table :test 'equal))
        (gomuks--member-state (make-hash-table :test 'equal))
        (gomuks--requested-members (make-hash-table :test 'equal))
        (gomuks--timelines (make-hash-table :test 'equal))
        (gomuks--timeline-ids (make-hash-table :test 'equal))
        (gomuks--stream nil)
        (requests 0)
        (id "!initial:test"))
    (unwind-protect
        (save-window-excursion
          (puthash id '((name . "Initial room")) gomuks--rooms)
          (with-current-buffer (get-buffer-create "*Gomuks test home*")
            (gomuks-rooms-mode)
            (let ((inhibit-read-only t))
              (insert "Initial room\n")
              (put-text-property (point-min) (point-max) 'gomuks-room-id id))
            (goto-char (point-min)))
          (cl-letf (((symbol-function 'gomuks--post)
                     (lambda (command data callback)
                       (should (equal command "paginate"))
                       (should (= (gomuks--alist 'limit data) 50))
                       (setq requests (1+ requests))
                       (funcall callback nil
                                '((events . (((rowid . 1)
                                              (timeline_rowid . 1)
                                              (room_id . "!initial:test")
                                              (event_id . "$initial")
                                              (type . "m.room.message")
                                              (sender . "@a:test")
                                              (content . ((body . "First page")))))))))))
            (with-current-buffer "*Gomuks test home*"
              (goto-char (point-min))
              (gomuks-open-room))
            (should (= requests 1))
            (with-current-buffer (format "*Gomuks: %s*" id)
              (should (string-match-p "First page" (buffer-string))))
            (with-current-buffer "*Gomuks test home*" (gomuks-open-room))
            (should (= requests 1))))
      (dolist (name (list "*Gomuks test home*" (format "*Gomuks: %s*" id)
                          (format "*Gomuks compose: %s*" id)))
        (when-let* ((buffer (get-buffer name))) (kill-buffer buffer))))))

(ert-deftest gomuks-room-render-keeps-scroll-position-and-bottom ()
  (let ((gomuks--rooms (make-hash-table :test 'equal))
        (gomuks--events (make-hash-table :test 'equal))
        (gomuks--timelines (make-hash-table :test 'equal))
        (gomuks--member-state (make-hash-table :test 'equal))
        (gomuks--requested-members (make-hash-table :test 'equal))
        (gomuks--stream nil)
        (id "!scroll:test")
        (room (generate-new-buffer "*gomuks-scroll-test*")))
    (unwind-protect
        (save-window-excursion
          (dotimes (index 80)
            (let ((rowid (1+ index)))
              (puthash rowid
                       `((rowid . ,rowid) (room_id . ,id)
                         (event_id . ,(format "$%s" rowid))
                         (sender . "@a:test") (type . "m.room.message")
                         (timestamp . ,(* rowid 60000))
                         (content . ((body . ,(format "Message %s" rowid)))))
                       gomuks--events)))
          (puthash id (number-sequence 1 80) gomuks--timelines)
          (with-current-buffer room
            (gomuks-room-mode)
            (setq gomuks--room-id id))
          (switch-to-buffer room)
          (gomuks--render-buffer room id)
          (let ((window (selected-window)))
            (with-current-buffer room
              (let ((position (text-property-any (point-min) (point-max)
                                                 'gomuks-event-rowid 10)))
                (set-window-point window position)
                (set-window-start window position t)
                (redisplay t))
              (let ((before (get-text-property (window-start window)
                                               'gomuks-event-rowid)))
                (should (and before (< before 80)))
              (puthash 81
                       `((rowid . 81) (room_id . ,id) (event_id . "$81")
                         (sender . "@a:test") (type . "m.room.message")
                         (timestamp . 4860000)
                         (content . ((body . "Message 81"))))
                       gomuks--events)
              (puthash id (number-sequence 1 81) gomuks--timelines)
              (gomuks--render-buffer room id)
              (should (equal (get-text-property (window-start window)
                                                'gomuks-event-rowid) before)))
              (goto-char (point-max))
              (recenter -1)
              (let* ((composer (generate-new-buffer "*gomuks-scroll-composer-test*"))
                     (composer-window (split-window window -6 'below)))
                (unwind-protect
                    (progn
                      (set-window-buffer composer-window composer)
                      (with-selected-window window
                        (goto-char (point-max))
                        (recenter -1))
                      (select-window composer-window)
                      (puthash 82
                               `((rowid . 82) (room_id . ,id) (event_id . "$82")
                                 (sender . "@a:test") (type . "m.room.message")
                                 (timestamp . 4920000)
                                 (content . ((body . "Message 82"))))
                               gomuks--events)
                      (puthash id (number-sequence 1 82) gomuks--timelines)
                      (gomuks--render-buffer room id)
                      (should (= (window-point window)
                                 (with-current-buffer room (point-max)))))
                  (kill-buffer composer))))))
      (kill-buffer room))))

(ert-deftest gomuks-reply-uses-matrix-relation ()
  (let ((sent nil))
    (cl-letf (((symbol-function 'gomuks--post)
               (lambda (command data _callback)
                 (setq sent (cons command data)))))
      (with-temp-buffer
        (gomuks-room-mode)
        (setq gomuks--room-id "!room:test")
        (let ((inhibit-read-only t))
          (insert "message\n")
          (put-text-property (point-min) (point-max) 'gomuks-event
                             '((event_id . "$event"))))
        (goto-char (point-min))
        (gomuks-reply "reply")))
    (should (equal (car sent) "send_message"))
    (should (equal (gomuks--alist 'event_id
                                  (gomuks--alist 'm.in_reply_to
                                                 (gomuks--alist 'relates_to (cdr sent))))
                   "$event"))
    (should (string-match-p "m.in_reply_to"
                            (json-serialize (cdr sent))))))

(ert-deftest gomuks-active-room-marks-newest-visible-message-read ()
