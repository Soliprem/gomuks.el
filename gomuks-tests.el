(ert-deftest gomuks-reaction-serializes-matrix-content ()
  (let ((sent nil))
    (cl-letf (((symbol-function 'gomuks--post)
               (lambda (_command data _callback) (setq sent data))))
      (with-temp-buffer
        (gomuks-room-mode)
