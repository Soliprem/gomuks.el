        (save-window-excursion
          (puthash "!room:test" '((unread_messages . 2)) gomuks--rooms)
          (puthash 1 '((rowid . 1) (event_id . "$latest")) gomuks--events)
          (puthash "!room:test" '(1) gomuks--timelines)
          (with-current-buffer room
            (gomuks-room-mode)
            (setq gomuks--room-id "!room:test")
            (let ((inhibit-read-only t)) (insert "latest\n")))
          (switch-to-buffer room)
          (cl-letf (((symbol-function 'gomuks--post)
                     (lambda (command data callback)
                       (push (cons command data) sent)
