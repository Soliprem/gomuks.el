(defmacro gomuks-test-with-context-request (kind &rest body)
  "Run BODY after capturing a context request of KIND.
KIND is reply-context, reply-fallback, or search-context.  BODY can use
callback, response, context, source, requests, and effects.  Context setup
and ingestion run normally; network, rendering, and window effects are
replaced at their boundaries."
  (declare (indent 1) (debug (form body)))
  `(gomuks-test-with-state
     (let* ((kind ,kind)
            (target-event '((rowid . 42) (room_id . "!context:test")
                            (event_id . "$target") (timestamp . 3000)))
            (response
             (if (eq kind 'reply-fallback) target-event
               `((event . ,target-event)
                 (before . (((rowid . 2) (event_id . "$before-newer"))
                            ((rowid . 1) (event_id . "$before-older"))))
                 (after . (((rowid . 43) (event_id . "$after"))))
                 (related_events . (((rowid . 44) (event_id . "$related")))))))
            (context (generate-new-buffer " *gomuks-context-request-test*"))
            callback source requests effects)
       (unwind-protect
           (with-temp-buffer
             (if (eq kind 'search-context) (gomuks-search-mode) (gomuks-room-mode))
             (setq gomuks--room-id "!context:test"
                   source (current-buffer))
             (gomuks--reset-cache)
             (cl-letf (((symbol-function 'gomuks--event-at-point)
                        (lambda () target-event))
                       ((symbol-function 'gomuks--event-id-position) #'ignore)
                       ((symbol-function 'get-buffer-create)
                        (lambda (_name) context))
                       ((symbol-function 'gomuks--render-buffer)
                        (lambda (&rest _) (push 'render effects)))
                       ((symbol-function 'gomuks--show-room)
                        (lambda (&rest _) (push 'show effects)))
                       ((symbol-function 'message)
                        (lambda (&rest _) (push 'feedback effects)))
                       ((symbol-function 'gomuks--post)
                        (lambda (command data completion)
                          (should (equal (gomuks--alist 'room_id data) "!context:test"))
                          (should (equal (gomuks--alist 'event_id data) "$target"))
                          (push (list command completion) requests)
                          (push (list 'request command) effects))))
               (if (eq kind 'search-context)
                   (gomuks-search-open)
                 (gomuks-follow-reply "$target"))
               (should (equal (caar requests) "get_event_context"))
               (when (eq kind 'reply-fallback)
                 (funcall (cadar requests) "context unavailable" nil)
                 (should (equal (caar requests) "get_event")))
               (setq callback (cadar requests) effects nil)
               ,@body))
         (kill-buffer context)))))

(ert-deftest gomuks-context-ignores-success-from-before-cache-reset ()
  (dolist (kind '(reply-context reply-fallback search-context))
    (ert-info ((format "Context request: %s" kind))
      (gomuks-test-with-context-request kind
        (gomuks--apply-sync '((clear_state . t)))
        (let ((fresh '((rowid . 99) (event_id . "$fresh")))
              (request-count (length requests)))
          (puthash 99 fresh gomuks--events)
          (with-current-buffer context
            (gomuks-room-mode)
            (setq gomuks--room-id "!context:test"
                  gomuks--context-target "$fresh"
                  gomuks--context-events (list fresh)))
          (funcall callback nil response)
          (should (= (hash-table-count gomuks--events) 1))
          (should (equal (gethash 99 gomuks--events) fresh))
          (should (equal (buffer-local-value 'gomuks--context-target context) "$fresh"))
          (should (equal (buffer-local-value 'gomuks--context-events context) (list fresh)))
          (should (= (length requests) request-count))
          (should-not effects))))))

