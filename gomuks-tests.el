                   (content . ((body . "smile")
                               (url . "mxc://test/sticker"))))))
      (cl-letf (((symbol-function 'gomuks--cached-media)
                 (lambda (_attachment) "/tmp/sticker.png"))
                ((symbol-function 'gomuks--maybe-preview-image) #'ignore)
                ((symbol-function 'display-images-p) (lambda (&rest _) t))
