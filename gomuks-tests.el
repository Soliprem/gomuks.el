      (kill-buffer other))))

(ert-deftest gomuks-reply-preview-follows-parent ()
  (let* ((gomuks--events (make-hash-table :test 'equal))
         (parent '((rowid . 1) (room_id . "!room:test")
                   (event_id . "$parent") (sender . "@a:test")
                   (type . "m.room.message")
                   (content . ((body . "Original")))))
         (reply '((rowid . 2) (room_id . "!room:test")
                  (event_id . "$reply") (sender . "@b:test")
                  (type . "m.room.message")
                  (content . ((body . "> <@a:test> Original\n\nAnswer")
                              (m.relates_to . ((m.in_reply_to .
                                                ((event_id . "$parent")))))))))
         (room (generate-new-buffer "*gomuks-reply-test*")))
    (unwind-protect
        (save-window-excursion
          (puthash 1 parent gomuks--events)
          (with-current-buffer room
            (gomuks-room-mode)
            (setq gomuks--room-id "!room:test")
            (let ((inhibit-read-only t))
              (gomuks--insert-event parent)
              (gomuks--insert-event reply))
            (should (string-match-p "↪ a: Original" (buffer-string)))
            (should-not (string-match-p "> <@a:test>" (buffer-string))))
          (switch-to-buffer room)
          (goto-char (point-min))
          (search-forward "Answer")
          (gomuks-follow-reply)
          (should (equal (gomuks--alist 'event_id (gomuks--event-at-point))
                         "$parent")))
      (kill-buffer room))))

(ert-deftest gomuks-search-pages-and-returns-from-result-context ()
  (let* ((gomuks--rooms (make-hash-table :test 'equal))
         (gomuks--events (make-hash-table :test 'equal))
         (gomuks--member-state (make-hash-table :test 'equal))
         (gomuks--requested-members (make-hash-table :test 'equal))
         (gomuks--stream nil)
         (id "!search:test")
         (first '((rowid . 1) (room_id . "!search:test")
                  (event_id . "$first") (sender . "@a:test")
                  (type . "m.room.message")
                  (content . ((body . "first match")))))
         (second '((rowid . 2) (room_id . "!search:test")
                   (event_id . "$second") (sender . "@a:test")
                   (type . "m.room.message")
                   (content . ((body . "second match")))))
         (room (generate-new-buffer "*gomuks-search-source-test*"))
         (search-name (format "*Gomuks search: %s*" id))
         (context-name "*Gomuks context: $first*")
         (requests nil))
    (unwind-protect
        (save-window-excursion
          (puthash id '((name . "Search room")) gomuks--rooms)
          (with-current-buffer room
            (gomuks-room-mode)
            (setq gomuks--room-id id))
          (switch-to-buffer room)
          (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "match"))
                    ((symbol-function 'gomuks--post)
                     (lambda (command data callback)
                       (push (cons command data) requests)
                       (pcase command
                         ("search_local"
                          (funcall callback nil
                                   (if (gomuks--alist 'next_batch data)
                                       `((events . (,second)))
                                     `((events . (,first))
                                       (next_batch . "next")))))
                         ("get_event_context"
                          (funcall callback nil `((event . ,first))))))))
            (gomuks-search)
            (with-current-buffer search-name
              (should (= (length gomuks--search-results) 1))
              (should (equal gomuks--search-next-batch "next"))
              (gomuks-search-more)
              (should (= (length gomuks--search-results) 2))
              (should-not gomuks--search-next-batch)
              (goto-char (point-min))
              (search-forward "first match")
              (gomuks-search-open))
            (should (equal (gomuks--alist 'next_batch
                                         (cdr (cadr requests))) "next"))
            (with-current-buffer context-name (gomuks-back))
            (should (eq (window-buffer (selected-window))
                        (get-buffer search-name)))
            (with-current-buffer search-name (gomuks-search-back))
            (should (eq (window-buffer (selected-window)) room))))
      (dolist (name (list search-name context-name
                          (format "*Gomuks compose: %s*" id)
                          (format "*Gomuks compose: %s $first*" id)))
        (when-let* ((buffer (get-buffer name))) (kill-buffer buffer)))
      (kill-buffer room))))

(ert-deftest gomuks-request-keeps-buffer-displayed-by-callback ()
  (let ((response-buffer nil)
        (target (generate-new-buffer "*gomuks-request-target-test*")))
    (unwind-protect
        (save-window-excursion
          (cl-letf (((symbol-function 'url-retrieve)
                     (lambda (_url callback &rest _)
                       (setq response-buffer
                             (generate-new-buffer " *gomuks-response-test*"))
                       (with-current-buffer response-buffer
                         (insert "HTTP/1.1 200 OK\r\n\r\n{}")
                         (setq-local url-http-response-status 200)
                         (funcall callback nil)))))
            (gomuks--request
             "test" "{}"
             (lambda (failure _response)
               (should-not failure)
               (switch-to-buffer target))))
          (should-not (buffer-live-p response-buffer))
          (should (buffer-live-p target)))
      (when (buffer-live-p response-buffer) (kill-buffer response-buffer))
      (kill-buffer target))))

(ert-deftest gomuks-thread-reply-keeps-thread-relation ()
  (let (sent)
    (cl-letf (((symbol-function 'gomuks--post)
               (lambda (_command data _callback) (setq sent data))))
      (with-temp-buffer
        (gomuks-room-mode)
        (setq gomuks--room-id "!room:test"
              gomuks--thread-root "$root")
        (let ((inhibit-read-only t))
          (insert "reply\n")
          (put-text-property (point-min) (point-max) 'gomuks-event
                             '((event_id . "$parent"))))
        (goto-char (point-min))
        (gomuks-reply "inside thread")))
    (let ((relation (gomuks--alist 'relates_to sent)))
      (should (equal (gomuks--alist 'rel_type relation) "m.thread"))
      (should (equal (gomuks--alist 'event_id relation) "$root"))
      (should (equal (gomuks--alist 'event_id
                                   (gomuks--alist 'm.in_reply_to relation))
                     "$parent")))))

(ert-deftest gomuks-thread-opens-from-reply-and-merges-history ()
  (let* ((gomuks--events (make-hash-table :test 'equal))
         (gomuks--rooms (make-hash-table :test 'equal))
         (gomuks--timelines (make-hash-table :test 'equal))
         (root '((rowid . 1) (room_id . "!room:test")
                 (event_id . "$root") (sender . "@a:test")
                 (type . "m.room.message") (timestamp . 1000)
                 (content . ((body . "Root")))))
         (early '((rowid . 2) (room_id . "!room:test")
                  (event_id . "$early") (sender . "@b:test")
                  (type . "m.room.message") (timestamp . 3000)
                  (relates_to . "$root") (relation_type . "m.thread")
                  (content . ((body . "Early")))))
         (late '((rowid . 3) (room_id . "!room:test")
                 (event_id . "$late") (sender . "@b:test")
                 (type . "m.room.message") (timestamp . 4000)
                 (relates_to . "$root") (relation_type . "m.thread")
                 (content . ((body . "Late")))))
         (older '((rowid . 4) (room_id . "!room:test")
                  (event_id . "$older") (sender . "@b:test")
                  (type . "m.room.message") (timestamp . 2000)
                  (relates_to . "$root") (relation_type . "m.thread")
                  (content . ((body . "Older")))))
         (room (get-buffer-create "*gomuks-thread-source-test*"))
         (thread-name "*Gomuks thread: $root*"))
    (unwind-protect
        (save-window-excursion
          (puthash 1 root gomuks--events)
          (with-current-buffer room
            (gomuks-room-mode)
            (setq gomuks--room-id "!room:test")
            (let ((inhibit-read-only t))
              (gomuks--insert-event late))
            (goto-char (point-min)))
          (switch-to-buffer room)
          (cl-letf (((symbol-function 'gomuks--post)
                     (lambda (command data callback)
                       (should (equal command "paginate_manual"))
                       (should (equal (gomuks--alist 'thread_root data) "$root"))
                       (funcall callback nil
                                (if (gomuks--alist 'since data)
                                    `((events . (,early ,older))
                                      (next_batch . ""))
                                  `((events . (,late ,early))
                                    (next_batch . "older")))))))
            (gomuks-open-thread)
            (with-current-buffer thread-name
              (should (equal gomuks--thread-root "$root"))
              (should (eq gomuks--parent-buffer room))
              (should (equal (mapcar (lambda (event)
                                       (gomuks--alist 'event_id event))
                                     gomuks--thread-events)
                             '("$root" "$early" "$late")))
              (should (equal gomuks--thread-next-batch "older"))
              (gomuks-open-thread late)
              (should (equal gomuks--thread-next-batch "older"))
              (gomuks-load-history)
              (should (equal (mapcar (lambda (event)
                                       (gomuks--alist 'event_id event))
                                     gomuks--thread-events)
                             '("$root" "$older" "$early" "$late")))
              (should-not gomuks--thread-next-batch))))
      (dolist (name (list thread-name
                          "*Gomuks compose: !room:test thread $root*"
                          "*Gomuks compose: !room:test*"))
        (when-let* ((buffer (get-buffer name))) (kill-buffer buffer)))
      (kill-buffer room))))

(ert-deftest gomuks-fetches-missing-room-member-name ()
  (let ((gomuks--stream 'test)
        (gomuks--events (make-hash-table :test 'equal))
        (gomuks--member-state (make-hash-table :test 'equal))
        (gomuks--requested-members (make-hash-table :test 'equal))
        (message-event '((rowid . 1) (sender . "@a:test")
                         (type . "m.room.message")
                         (content . ((body . "Hi")))))
        (sent nil))
    (cl-letf (((symbol-function 'process-live-p) (lambda (_process) t))
              ((symbol-function 'gomuks--post)
               (lambda (command data callback)
                 (setq sent (cons command data))
                 (funcall callback nil
                          '(((rowid . 2) (room_id . "!room:test")
                             (type . "m.room.member")
                             (state_key . "@a:test")
                             (content . ((displayname . "Alice")))))))))
      (gomuks--request-missing-members "!room:test" (list message-event)))
    (should (equal (car sent) "get_specific_room_state"))
    (should (equal (gomuks--alist 'state_key
                                 (aref (gomuks--alist 'keys (cdr sent)) 0))
                   "@a:test"))
    (should (string-match-p "get_specific_room_state" (car sent)))
    (should (string-match-p "\\\"keys\\\":\\[" (json-serialize (cdr sent))))
    (should (equal (gomuks--sender-name "!room:test" message-event) "Alice"))))

(ert-deftest gomuks-stream-parses-split-json-lines ()
