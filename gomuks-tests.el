            (should (= (hash-table-count gomuks--events) 1))
            (should (equal (gethash 99 gomuks--events) fresh))
            (should (= (gethash "@a:test" (gethash "!members:test" gomuks--member-state)) 99))
            (should (eq (funcall request-pending) (if (eq kind 'missing) t 'loading)))
            (should-not effects)))))))

