              gomuks--reactions-event '((event_id . "$target")))
        (let ((inhibit-read-only t))
          (insert (propertize "Own reaction" 'gomuks-reaction-event-id "$reaction"
                              'gomuks-reaction-sender "@self:test")))
        (goto-char (point-min))
        (let (callback effects)
          (cl-letf (((symbol-function 'yes-or-no-p) (lambda (_) t))
                    ((symbol-function 'gomuks--post)
                     (lambda (_command _data completion) (setq callback completion))))
            (gomuks-remove-reaction))
          (gomuks--reset-room-cache "!room:test")
          (cl-letf (((symbol-function 'gomuks-show-reactions)
                     (lambda (&rest _) (push 'reopen effects)))
                    ((symbol-function 'message)
                     (lambda (&rest _) (push 'feedback effects))))
