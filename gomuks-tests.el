(defmacro gomuks-test-with-member-request (kind &rest body)
  "Run BODY after capturing a member request of KIND.
KIND is missing or mentions.  BODY can use callback, response, effects,
request-count, start-request, and request-pending.  The latter two are
functions that start another request and read its current pending marker."
  (declare (indent 1) (debug (form body)))
  `(gomuks-test-with-state
     (let* ((kind ,kind)
            (response '(((rowid . 42) (room_id . "!members:test")
                         (type . "m.room.member") (state_key . "@a:test")
                         (content . ((displayname . "Fetched name"))))
                        ((rowid . 43) (room_id . "!other:test")
                         (type . "m.room.member") (state_key . "@a:test"))
                        ((rowid . 44) (room_id . "!members:test")
                         (type . "m.room.message"))))
            (start-request
             (lambda ()
               (if (eq kind 'missing)
                   (gomuks--request-missing-members
                    "!members:test" '(((sender . "@a:test"))))
                 (gomuks--request-mention-members "!members:test"))))
            (request-pending
             (lambda ()
               (if (eq kind 'missing)
                   (gethash '("!members:test" . "@a:test") gomuks--requested-members)
                 (gethash "!members:test" gomuks--mention-members-loaded))))
            (request-count 0)
            callback effects)
       (gomuks--reset-cache)
       (cl-letf (((symbol-function 'process-live-p) (lambda (_process) t))
                 ((symbol-function 'gomuks--render-room)
                  (lambda (id) (push (list 'render id) effects)))
                 ((symbol-function 'gomuks--post)
                  (lambda (command _data completion)
                    (should (equal command (if (eq kind 'missing)
                                               "get_specific_room_state" "get_room_state")))
                    (setq callback completion
                          request-count (1+ request-count)))))
         (funcall start-request)
         (should (functionp callback))
         ,@body))))

