                                ((event_rowid . 2) (timeline_rowid . 12))
                                ((event_rowid . 3) (timeline_rowid . 13))))))))))
    (gomuks--store-members
     "!test" '(((rowid . 4) (room_id . "!test") (type . "m.room.member")
