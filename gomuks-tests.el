(ert-deftest gomuks-stream-rejects-chunks-from-replaced-process ()
  (gomuks-test-with-state
    (setq gomuks--stream 'current gomuks--pending "partial")
    (gomuks--stream-filter 'old "discarded\n")
    (should (equal gomuks--pending "partial"))
    (should (= (hash-table-count gomuks--rooms) 0))
    (setq gomuks--pending "")
    (gomuks--stream-filter
     'current "{\"command\":\"client_state\",\"data\":{\"user_id\":\"@self:test\",\"is_initialized\":true}}\n")
    (should (equal gomuks--user-id "@self:test"))
    (should (equal gomuks--pending ""))))

(ert-deftest gomuks-request-invokes-handler-once-and-cleans-response-buffer ()
  (dolist (body '("{}" "invalid JSON"))
    (let (calls response-buffer)
      (cl-letf (((symbol-function 'url-retrieve)
                 (lambda (_url callback &rest _)
                   (setq response-buffer (generate-new-buffer " *gomuks-http-owner-test*"))
                   (with-current-buffer response-buffer
                     (insert "HTTP/1.1 200 OK\r\n\r\n" body)
                     (setq-local url-http-response-status 200)
                     (funcall callback nil)))))
        (should-error
         (gomuks--request "test" "{}"
                          (lambda (failure _response)
                            (push failure calls) (error "Consumer failure")))))
      (should (= (length calls) 1))
      (should (eq (not (null (car calls))) (equal body "invalid JSON")))
      (should-not (buffer-live-p response-buffer)))))

(ert-deftest gomuks-member-lookup-outlives-source-view ()
