;;; gomuks-tests.el --- Tests for gomuks.el -*- lexical-binding: t; -*-

(require 'ert)
(require 'gomuks)

(defun gomuks-test-confirm-delivery (callback)
  "Simulate acceptance followed by a separately correlated stream completion."
  (let* ((row (+ 10000 (cl-incf gomuks--send-serial)))
         (pending `((rowid . ,row) (transaction_id . ,(format "txn-%d" row))
                    (event_id . ,(format "~txn-%d" row)) (send_error . "not sent"))))
    (funcall callback nil pending)
    (gomuks--complete-send `((event . ,(cons `(event_id . ,(format "$sent-%d" row)) pending))))))



(ert-deftest gomuks-renders-matrix-html-and-hides-reply-fallback ()
  (with-temp-buffer
    (gomuks-room-mode)
    (setq gomuks--room-id "!room:test")
    (let ((event '((event_id . "$reply")
                   (sender . "@alice:test")
                   (type . "m.room.message")
                   (content . ((body . "> old\n\nHello bold and link")
                               (format . "org.matrix.custom.html")
                               (formatted_body . "<mx-reply><blockquote>old</blockquote></mx-reply><p>Hello <strong>bold</strong> and <a href=\"https://example.org\">link</a></p>")
                               (m.relates_to . ((m.in_reply_to . ((event_id . "$old"))))))))))
      (let ((inhibit-read-only t))
        (gomuks--insert-event event))
      (should (string-match-p "Hello bold and link" (buffer-string)))
      (should-not (string-match-p "old</blockquote>\|> old" (buffer-string)))
      (goto-char (point-min))
      (search-forward "bold")
      (should (get-text-property (1- (point)) 'face))
      (search-forward "link")
      (should (equal (get-text-property (1- (point)) 'shr-url)
                     "https://example.org")))))

(ert-deftest gomuks-switch-room-lists-recent-first ()
  (let ((gomuks--rooms (make-hash-table :test 'equal))
        (gomuks--hidden-room-ids nil)
        choices opened)
    (puthash "!older:test" '((name . "Same") (sorting_timestamp . 1)) gomuks--rooms)
    (puthash "!newer:test" '((name . "Same") (sorting_timestamp . 2)
                              (unread_notifications . 3)) gomuks--rooms)
    (cl-letf (((symbol-function 'completing-read)
               (lambda (_prompt candidates &rest _)
                 (setq choices candidates)
                 (caar candidates)))
              ((symbol-function 'gomuks--open-room-id)
               (lambda (id) (setq opened id))))
      (gomuks-switch-room)
      (should (equal opened "!newer:test"))
      (should (equal (mapcar #'cdr choices)
                     '("!newer:test" "!older:test")))
      (should (string-match-p "(3)" (caar choices))))))

(ert-deftest gomuks-hidden-rooms-stay-out-of-normal-navigation ()
  (let ((gomuks--rooms (make-hash-table :test 'equal))
        (gomuks--hidden-room-ids '("!secret:test"))
        (gomuks--events (make-hash-table :test 'equal))
        (gomuks--connection-status "Disconnected")
        (gomuks--stream nil)
        choices opened)
    (puthash "!visible:test" '((name . "Visible") (unread_notifications . 2))
             gomuks--rooms)
    (puthash "!secret:test" '((name . "Secret") (unread_notifications . 7))
             gomuks--rooms)
    (unwind-protect
        (progn
          (with-current-buffer (get-buffer-create "*Gomuks*")
            (gomuks-rooms-mode)
            (gomuks--render-rooms)
            (should (string-match-p "1 rooms  ·  2 unread" (buffer-string)))
            (should (string-match-p "Visible" (buffer-string)))
            (should-not (string-match-p "Secret" (buffer-string))))
          (cl-letf (((symbol-function 'completing-read)
                     (lambda (_prompt candidates &rest _)
                       (setq choices candidates)
                       (caar candidates)))
                    ((symbol-function 'gomuks--open-room-id)
                     (lambda (id) (setq opened id))))
            (gomuks-switch-room)
            (should (equal opened "!visible:test"))
            (should (equal (mapcar #'cdr choices) '("!visible:test")))
            (gomuks-switch-hidden-room)
            (should (equal opened "!secret:test"))
            (should (equal (mapcar #'cdr choices) '("!secret:test")))))
      (when-let* ((buffer (get-buffer "*Gomuks*"))) (kill-buffer buffer)))))

(ert-deftest gomuks-hidden-rooms-persist-and-suppress-notifications ()
  (let* ((directory (make-temp-file "gomuks-hidden-test-" t))
         (gomuks-hidden-rooms-file (expand-file-name "hidden" directory))
         (gomuks--hidden-room-ids nil)
         (gomuks--rooms (make-hash-table :test 'equal))
         (gomuks--muted-rooms (make-hash-table :test 'equal))
         (gomuks-echo-area-notifications t)
         (gomuks-desktop-notifications nil)
         notices)
    (unwind-protect
        (progn
          (puthash "!secret:test" '((name . "Secret")) gomuks--rooms)
          (with-temp-buffer
            (gomuks-room-mode)
            (setq gomuks--room-id "!secret:test")
            (gomuks-toggle-hidden-room))
          (should (equal gomuks--hidden-room-ids '("!secret:test")))
          (should (= (file-modes gomuks-hidden-rooms-file) #o600))
          (setq gomuks--hidden-room-ids nil)
          (gomuks--load-hidden-rooms)
          (should (equal gomuks--hidden-room-ids '("!secret:test")))
          (cl-letf (((symbol-function 'message)
                     (lambda (&rest args) (push args notices))))
            (gomuks--notify "!secret:test"
                            '((sender . "@alice:test")
                              (content . ((body . "private"))))))
          (should-not notices)
          (with-temp-buffer
            (gomuks-room-mode)
            (setq gomuks--room-id "!secret:test")
            (gomuks-toggle-hidden-room))
          (should-not gomuks--hidden-room-ids)
          (gomuks--load-hidden-rooms)
          (should-not gomuks--hidden-room-ids))
      (delete-directory directory t))))

(ert-deftest gomuks-uses-auth-source-and-allows-session-override ()
  (let ((gomuks-backend-url "https://chat.example:8443")
        (gomuks-username nil)
        (gomuks--password nil)
        (gomuks--skip-auth-source nil)
        (gomuks--stream nil)
        (queries nil))
    (cl-letf (((symbol-function 'auth-source-search)
               (lambda (&rest args)
                 (push args queries)
                 (list (list :user "stored-user"
                             :secret (lambda () "stored-password")))))
              ((symbol-function 'gomuks-home) #'ignore)
              ((symbol-function 'gomuks--start-stream) #'ignore)
              ((symbol-function 'read-string)
               (lambda (&rest _) (error "Unexpected username prompt")))
              ((symbol-function 'read-passwd)
               (lambda (&rest _) (error "Unexpected password prompt"))))
      (gomuks)
      (should (equal gomuks-username "stored-user"))
      (should (equal gomuks--password "stored-password"))
      (should (equal (plist-get (car queries) :host) "chat.example"))
      (should (equal (plist-get (car queries) :port) "8443")))
    (setq gomuks-username nil gomuks--password nil
          gomuks--skip-auth-source t)
    (cl-letf (((symbol-function 'auth-source-search)
               (lambda (&rest _) (error "Stored credentials were reused")))
              ((symbol-function 'gomuks-home) #'ignore)
              ((symbol-function 'gomuks--start-stream) #'ignore)
              ((symbol-function 'read-string) (lambda (&rest _) "new-user"))
              ((symbol-function 'read-passwd) (lambda (&rest _) "new-password")))
      (gomuks)
      (should (equal gomuks-username "new-user"))
      (should (equal gomuks--password "new-password")))))

