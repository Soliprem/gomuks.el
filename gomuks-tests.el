(ert-deftest gomuks-reaction-loading-respects-cache-and-view-ownership ()
  (dolist (identified '(nil t))
    (dolist (change '(reset repurpose current))
      (gomuks-test-with-state
        (let ((gomuks--user-id (and identified "@self:test"))
              (reaction-buffer (generate-new-buffer " *gomuks-reaction-owner-test*"))
              callbacks commands)
          (unwind-protect
              (with-temp-buffer
                (gomuks-room-mode)
                (setq gomuks--room-id "!room:test")
                (cl-letf (((symbol-function 'get-buffer-create) (lambda (_) reaction-buffer))
                          ((symbol-function 'display-buffer) (lambda (&rest _) (selected-window)))
                          ((symbol-function 'select-window) #'ignore)
                          ((symbol-function 'gomuks--post)
                           (lambda (command _data completion)
                             (push command commands) (push completion callbacks))))
                  (gomuks-show-reactions '((event_id . "$target")) "key")
                  (pcase change
                    ('reset (gomuks--apply-sync '((rooms . (("!room:test" . ((reset . t))))))))
                    ('repurpose (with-current-buffer reaction-buffer
                                  (setq gomuks--reactions-key "other"))))
                  (let ((before (with-current-buffer reaction-buffer (buffer-string))))
                    (funcall (car callbacks) nil
                             (if identified nil '((user_id . "@loaded:test"))))
                    (if (eq change 'current)
                        (if identified
                            (should (with-current-buffer reaction-buffer
                                      (string-match-p "No reactions found" (buffer-string))))
                          (should (equal gomuks--user-id "@loaded:test"))
                          (should (= (length commands) 2)))
                      (should (= (length commands) 1))
                      (should (equal gomuks--user-id (and identified "@self:test")))
                      (should (equal before (with-current-buffer reaction-buffer (buffer-string))))))))
            (kill-buffer reaction-buffer)))))))

