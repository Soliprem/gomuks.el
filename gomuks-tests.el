(defmacro gomuks-test-with-thread-request (kind &rest body)
  "Run BODY in a thread buffer after capturing a request of KIND.
KIND is older-page, initial-page, or missing-root.  BODY can use callback,
response, and effects.  Rendering and networking are replaced at their
boundaries; the thread commands and their callbacks run normally."
  (declare (indent 1) (debug (form body)))
  `(gomuks-test-with-state
    (let* ((kind ,kind)
           (root-event '((rowid . 1) (room_id . "!room:test")
                         (event_id . "$root") (timestamp . 1000)))
           (reply-event '((rowid . 42) (room_id . "!room:test")
                          (event_id . "$reply") (timestamp . 2000)
                          (relation_type . "m.thread") (relates_to . "$root")))
           (response (if (eq kind 'missing-root)
                         (append '((rowid . 42)) (cdr root-event))
                       `((events . (,reply-event))
                         (related_events . (((rowid . 43) (event_id . "$related"))))
                         (next_batch . "next-page"))))
           (thread (generate-new-buffer " *gomuks-thread-request-test*"))
           callback effects)
      (unwind-protect
          (with-temp-buffer
            (gomuks-room-mode)
            (setq gomuks--room-id "!room:test")
            (gomuks--reset-cache)
            (cl-letf (((symbol-function 'get-buffer-create)
                       (lambda (_name) thread))
                      ((symbol-function 'gomuks--render-buffer) #'ignore)
                      ((symbol-function 'gomuks--show-room) #'ignore)
                      ((symbol-function 'gomuks--post)
                       (lambda (command data completion)
                         (when (equal command (if (eq kind 'missing-root)
                                                  "get_event" "paginate_manual"))
                           (should (equal (gomuks--alist 'room_id data) "!room:test"))
                           (should (equal (gomuks--alist
                                           (if (eq kind 'missing-root)
                                               'event_id 'thread_root)
                                           data)
                                          "$root"))
                           (when (eq kind 'older-page)
                             (should (equal (gomuks--alist 'since data) "old-page")))
                           (setq callback completion)))))
              (if (eq kind 'older-page)
                  (with-current-buffer thread
                    (gomuks-room-mode)
                    (setq gomuks--room-id "!room:test"
                          gomuks--thread-root "$root"
                          gomuks--thread-events (list root-event)
                          gomuks--thread-next-batch "old-page")
                    (gomuks--store-events (list root-event))
                    (gomuks-load-history))
                (gomuks-open-thread
                 (if (eq kind 'missing-root) reply-event root-event)))
              (should (functionp callback))
              (with-current-buffer thread
                ,@body)))
        (kill-buffer thread)))))

