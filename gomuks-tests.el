(ert-deftest gomuks-delivery-commits-once-with-an-independent-cache-lifetime ()
  (dolist (stale '(nil t))
    (gomuks-test-with-state
     (let* ((file (make-temp-file "gomuks-delivery-owner-"))
            (attachment (list file t "Owned attachment"))
            (event '((rowid . 1) (room_id . "!delivery") (event_id . "$sent")
                     (transaction_id . "txn") (timeline_rowid . 10)))
            (send (gomuks--make-send :id 1 :phase 'queued :room "!delivery"
                                    :backend gomuks-backend-url :account gomuks--user-id
                                    :text "draft" :token (gomuks--cache-token "!delivery")
                                    :remaining (list attachment) :attachment attachment
                                    :event '((rowid . 1) (transaction_id . "txn"))))
            (store (symbol-function 'gomuks--store-events)) (writes 0) (redraws 0))
       (unwind-protect
           (progn
             (puthash "!delivery" '((name . "Delivery")) gomuks--rooms)
             (puthash 1 send gomuks--sends)
             (when stale (gomuks--reset-room-cache "!delivery"))
             (cl-letf (((symbol-function 'gomuks--store-events)
                        (lambda (events) (cl-incf writes) (funcall store events)))
                       ((symbol-function 'gomuks--update-room-views)
                        (lambda (_id) (cl-incf redraws))))
               (gomuks--complete-send `((event . ,event))))
             (should (= writes 1))
             (should (= redraws 1))
             (should (eq event (gethash 1 gomuks--events)))
             (should (equal (gethash "!delivery" gomuks--timelines) (unless stale '(1))))
             (should (eq (gomuks--send-phase send) 'delivered))
             (should (= (hash-table-count gomuks--sends) 0))
             (should-not (file-exists-p file)))
         (ignore-errors (delete-file file)))))))

