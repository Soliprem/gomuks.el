(ert-deftest gomuks-event-row-query-preserves-order-and-skips-missing-rows ()
  (gomuks-test-with-state
   (let* ((zero '((rowid . 0)))
          (first '((rowid . 1)))
          (second '((rowid . 2)))
          (rows '(0 99 nil 2 1 2))
          (original (copy-sequence rows)))
     (gomuks--store-events (list zero first second))
     (should (equal (gomuks--events-for-rows rows) (list zero second first second)))
     (should (equal rows original))
     (should (= (hash-table-count gomuks--events) 3))
     (let ((updated '((rowid . 2) (content . ((body . "Updated"))))))
       (gomuks--store-events (list updated))
       (should (eq (car (gomuks--events-for-rows '(2))) updated))))))

(ert-deftest gomuks-thread-render-resolves-current-cache-events ()
  (dolist (change '(redaction decryption removal))
    (ert-info ((format "Thread cache change: %s" change))
      (gomuks-test-with-state
       (let* ((root '((rowid . 1) (room_id . "!room:test") (event_id . "$root")
                      (sender . "@a:test") (type . "m.room.message")
                      (content . ((body . "Original root")))))
              (reply '((rowid . 2) (room_id . "!room:test") (event_id . "$reply")
                       (sender . "@b:test") (type . "m.room.encrypted")))
              (retained (list root reply))
              shown)
         (gomuks--store-events retained)
         (with-temp-buffer
           (gomuks-room-mode)
           (setq gomuks--room-id "!room:test" gomuks--thread-root "$root"
                 gomuks--thread-events retained)
           (let ((thread (current-buffer)))
             (cl-letf (((symbol-function 'gomuks--request-missing-members)
                        (lambda (_id events) (setq shown events)))
                       ((symbol-function 'gomuks--update-room-views)
                        (lambda (_id &optional _incoming) (gomuks--refresh-view thread))))
               (gomuks--refresh-view thread)
               (should (string-match-p "Original root" (buffer-string)))
               (should (string-match-p "\\[encrypted\\]" (buffer-string)))
               (pcase change
                 ('redaction
                  (let ((updated (cons '(redacted_by . "$redaction") root)))
                    (gomuks--handle-event
                     `((command . "sync_complete")
                       (data . ((rooms . (("!room:test" . ((events . (,updated))))))))))
                    (should (string-match-p "\\[redacted\\]" (buffer-string)))
                    (should-not (string-match-p "Original root" (buffer-string)))
                    (should (memq updated shown))))
                 ('decryption
                  (let ((updated '((rowid . 2) (room_id . "!room:test") (event_id . "$reply")
                                   (sender . "@new:test") (type . "m.room.message")
                                   (content . ((body . "Decrypted reply"))))))
                    (gomuks--handle-event
                     `((command . "events_decrypted")
                       (data . ((room_id . "!room:test") (events . (,updated))))))
                    (should (string-match-p "Decrypted reply" (buffer-string)))
                    (should-not (string-match-p "\\[encrypted\\]" (buffer-string)))
                    (should (memq updated shown))
                    (goto-char (text-property-any (point-min) (point-max)
                                                  'gomuks-event-rowid 2))
                    (should (eq (get-text-property (point) 'gomuks-event) updated))))
                 ('removal
                  (remhash 2 gomuks--events)
                  (gomuks--refresh-view thread)
                  (should-not (string-match-p "\\[encrypted\\]" (buffer-string)))
                  (should-not (memq reply shown))
                  (should (string-match-p "Original root" (buffer-string)))))
               (should (equal (gomuks--event-rows gomuks--thread-events) (gomuks--event-rows retained)))))))))))

